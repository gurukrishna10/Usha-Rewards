<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.usha.rewards</groupId>
        <artifactId>usha-rewards</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>usha-rewards.all</artifactId>
    <packaging>content-package</packaging>
    <name>Usha Rewards - All</name>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.jackrabbit</groupId>
                <artifactId>filevault-package-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <group>com.usha.rewards</group>
                    <name>usha-rewards.all</name>
                    <packageType>container</packageType>
                    <embeddeds>
                        <embedded>
                            <groupId>com.usha.rewards</groupId>
                            <artifactId>usha-rewards.core</artifactId>
                            <target>/apps/usha-rewards-packages/application/install</target>
                        </embedded>
                    </embeddeds>
                    <subPackages>
                        <subPackage>
                            <groupId>com.usha.rewards</groupId>
                            <artifactId>usha-rewards.ui.apps</artifactId>
                            <filter>true</filter>
                        </subPackage>
                        <subPackage>
                            <groupId>com.usha.rewards</groupId>
                            <artifactId>usha-rewards.ui.apps.structure</artifactId>
                            <filter>true</filter>
                        </subPackage>
                        <subPackage>
                            <groupId>com.usha.rewards</groupId>
                            <artifactId>usha-rewards.ui.config</artifactId>
                            <filter>true</filter>
                        </subPackage>
                        <subPackage>
                            <groupId>com.usha.rewards</groupId>
                            <artifactId>usha-rewards.ui.content</artifactId>
                            <filter>true</filter>
                        </subPackage>
                    </subPackages>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>com.usha.rewards</groupId>
            <artifactId>usha-rewards.core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.usha.rewards</groupId>
            <artifactId>usha-rewards.ui.apps</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.usha.rewards</groupId>
            <artifactId>usha-rewards.ui.apps.structure</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.usha.rewards</groupId>
            <artifactId>usha-rewards.ui.config</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.usha.rewards</groupId>
            <artifactId>usha-rewards.ui.content</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
    </dependencies>
</project>
